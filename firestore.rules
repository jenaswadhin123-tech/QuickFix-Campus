rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAdmin() {
      return signedIn() && userRole() == 'admin';
    }
    function isStaff() {
      return signedIn() && userRole() == 'staff';
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.role in ['student', 'staff'];
      allow update: if signedIn() && (request.auth.uid == userId || isAdmin())
        && request.resource.data.role == resource.data.role;
      allow delete: if isAdmin();
    }

    match /issues/{issueId} {
      allow read: if signedIn() && (
        resource.data.reportedBy == request.auth.uid
        || resource.data.status == 'resolved'
        || isAdmin()
        || (isStaff() && resource.data.assignedStaffId == request.auth.uid)
      );
      allow create: if signedIn()
        && request.resource.data.reportedBy == request.auth.uid
        && request.resource.data.status == 'submitted';
      allow update: if isAdmin()
        || (isStaff() && resource.data.assignedStaffId == request.auth.uid
          && request.resource.data.reportedBy == resource.data.reportedBy
          && request.resource.data.status in ['assigned', 'inProgress', 'resolved'])
        || (signedIn() && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['reportCount', 'updatedAt', 'timeline'])
          && request.resource.data.reportCount == resource.data.reportCount + 1
          && request.resource.data.status == resource.data.status);
      allow delete: if isAdmin();
    }

    match /locations/{locationId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /notifications/{notificationId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create, update, delete: if isAdmin();
    }
    match /campus_alerts/{alertId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /duplicate_groups/{groupId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /assignments/{assignmentId} {
      allow read: if isAdmin() || (signedIn() && resource.data.staffId == request.auth.uid);
      allow write: if isAdmin();
    }
    match /analytics/{documentId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}